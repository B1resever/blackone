{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "extends": "base"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "extends": "base",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "extends": "base",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "base": {
      "env": {
        "EXPO_PUBLIC_ONE_API_URL": "https://b1reserve.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
