{
  "expo": {
    "name": "ONE",
    "slug": "black-one-one",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "one",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blackone.one",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": ["en", "es", "pt", "fr"]
      }
    },
    "android": {
      "package": "com.blackone.one",
      "versionCode": 2,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
