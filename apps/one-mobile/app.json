{
  "expo": {
    "name": "ONE",
    "slug": "black-one-one",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "one",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blackone.one",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "es",
          "pt",
          "fr"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.blackone.one",
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "../../logo.png.png",
        "backgroundColor": "#020609"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ONE to share the driver location with the passenger during an active trip."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "../../logo.png.png",
    "splash": {
      "image": "../../logo.png.png",
      "resizeMode": "contain",
      "backgroundColor": "#020609"
    }
  }
}
