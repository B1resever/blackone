{
  "name": "black-one-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.44.6",
    "stripe": "^18.5.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@vercel/node": "^5.5.5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "npm --prefix services/one-api test",
    "typecheck": "npm --prefix services/one-api run typecheck && npm --prefix apps/one-mobile run typecheck && npm run typecheck:routes",
    "release:check": "node scripts/one-release-check.mjs",
    "production:smoke": "node scripts/one-production-smoke.mjs",
    "typecheck:routes": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck api/one/*.ts"
  }
}
